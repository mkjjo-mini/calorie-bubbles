# Local development 환경변수 샘플.
# 이 파일은 git에 커밋되며, 실제 .env.local 은 .gitignore 대상.

# === Step 04: 식약처 식품영양성분 API ===
# https://www.data.go.kr/ "FoodNtrCpntDbInfo02" 활용신청 → Decoding 키
FOOD_API_KEY=

# === Step 01: 토스 mTLS 인증서 (dev 전용) ===
# 앱인토스 콘솔 → mTLS 인증서 → 발급받기 → ZIP 다운로드 후 풀어서 path 지정.
# prod (CF Workers)는 `wrangler mtls-certificate upload` + wrangler.jsonc binding 사용.
# PEM 파일 절대 git 커밋 금지 — 안전한 위치 (예: ~/Documents/BusinessDocs/mtls-tandanji-bubble-dev/)
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=

# (선택) PII 복호화 — 사용자 이름·전화 등 노출 기능 추가할 때만
# 채팅·이 파일에 키 붙여넣기 금지
TOSS_DECRYPT_KEY=

# Cookie Secure flag 토글. dev에서 http://localhost 쓸 땐 development.
ENVIRONMENT=development

# === Step 01: KV namespace (wrangler.jsonc에 binding) ===
# 셋업: `npx wrangler kv namespace create SESSIONS`
# 결과 id를 wrangler.jsonc의 kv_namespaces[0].id에 입력 (.env에는 안 들어감)
