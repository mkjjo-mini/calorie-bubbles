# Local development 환경변수 샘플.
# 이 파일은 git에 커밋되며, 실제 .env.local 은 .gitignore 대상.

# === Step 04: 식약처 식품영양성분 API ===
# https://www.data.go.kr/ "FoodNtrCpntDbInfo02" 활용신청 → Decoding 키
FOOD_API_KEY=

# === Step 01: 앱인토스 OAuth (개발용 — 실제로는 wrangler secret 권장) ===
# 프로덕션: `npx wrangler secret put TOSS_CLIENT_ID` / `npx wrangler secret put TOSS_CLIENT_SECRET`
# (시크릿은 채팅·이 파일에 붙여넣지 말 것)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Cookie Secure flag 토글. dev에서 http://localhost 쓸 땐 development.
ENVIRONMENT=development

# === Step 01: KV namespace (wrangler.jsonc에 binding) ===
# CLI: `npx wrangler kv namespace create SESSIONS`
# 결과 id를 wrangler.jsonc의 kv_namespaces[0].id에 채울 것
# (이 파일에는 안 들어감)
