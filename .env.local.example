# ============================================================================
#  Local development 환경변수 샘플.
#  실제 .env.local 은 .gitignore.
#
#  Standalone Auth 전환 후 (2026-05-18) — Toss mTLS / KV 관련 변수 모두 제거.
# ============================================================================

# === Supabase ===
# Supabase Dashboard → Settings → API
#   Project URL                → SUPABASE_URL
#   anon public key            → SUPABASE_ANON_KEY  (클라이언트 노출 OK)
#   service_role key           → SUPABASE_SERVICE_ROLE_KEY  (서버 전용, 절대 노출 X)
# 채팅·git에 service_role 키 노출 금지.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 클라이언트(브라우저)에서 supabase.auth를 호출하려면 VITE_ prefix로도 한번 더 노출.
# (Vite가 클라이언트 번들에 주입하는 건 VITE_ prefix만)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === 식약처 식품영양성분 API (Step 04) ===
# https://www.data.go.kr/ "FoodNtrCpntDbInfo02" → Decoding 키
FOOD_API_KEY=

# === Misc ===
# Cookie Secure flag 분기. dev http=development, prod https=production.
ENVIRONMENT=development

# 유료 사용자 강제 토글 (v1 mock — BM 확정 전까지)
FORCE_PAID=

# === Sentry 에러 모니터링 ===
# https://sentry.io 가입 → 프로젝트 "tandanji-bubble" → DSN 복사
# DSN은 공개 식별자라 클라이언트 노출 OK (VITE_ prefix로 빌드 타임 주입)
VITE_SENTRY_DSN=
