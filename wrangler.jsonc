{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	// Standalone Auth — KV(SESSIONS) / mTLS binding 모두 제거.
	// 세션은 Supabase Auth가 직접 쿠키로 관리.
	//
	// SUPABASE_URL, SUPABASE_ANON_KEY는 vars (공개 가능)
	// SUPABASE_SERVICE_ROLE_KEY는 `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY` (절대 vars X)
	"vars": {
		"ENVIRONMENT": "production",
		"SUPABASE_URL": "",
		"SUPABASE_ANON_KEY": ""
	}
}
